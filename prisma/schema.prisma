  notes                    String?                 @db.Text
  transaction_type         String?                 @default("NEW_SUBSCRIPTION") @db.VarChar(50)
  created_at               DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?               @default(now()) @db.Timestamptz(6)

  businesses             businesses              @relation(fields: [business_id], references: [id], onDelete: Cascade)
  platform_subscriptions platform_subscriptions? @relation(fields: [subscription_id], references: [id])
  platform_licenses      platform_licenses?      @relation(fields: [license_id], references: [id])
  payment_receipts       payment_receipts[]

  @@index([business_id], map: "idx_pay_tx_business")
  @@index([company_id], map: "idx_pay_tx_company")
  @@index([provider_payment_id], map: "idx_pay_tx_provider_pay_id")
  @@index([transaction_type], map: "idx_pay_tx_transaction_type")
}

model payment_receipts {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receipt_number String    @unique @db.VarChar(100)
  company_id     String    @db.VarChar(50)
  business_id    String    @db.Uuid
  payment_id     String    @db.Uuid
  amount         Decimal   @db.Decimal(14, 2)
  payment_date   DateTime  @db.Timestamptz(6)
  status         String    @default("ISSUED") @db.VarChar(50)
  pdf_url        String?   @db.Text
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  businesses           businesses           @relation(fields: [business_id], references: [id], onDelete: Cascade)
  payment_transactions payment_transactions @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([business_id], map: "idx_receipt_business")
}

model webhook_events {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id      String    @unique @db.VarChar(150)
  provider      String    @default("RAZORPAY") @db.VarChar(50)
  event_type    String    @db.VarChar(100)
  payload       Json
  status        String    @default("PROCESSED") @db.VarChar(50)
  processed_at  DateTime? @default(now()) @db.Timestamptz(6)
  error_message String?   @db.Text
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
}

model admin_users {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String     @db.VarChar(150)
  email         String     @unique @db.VarChar(150)
  phone         String?    @db.VarChar(20)
  password_hash String
  role          admin_role @default(SUPER_ADMIN)
  is_active     Boolean    @default(true)
  last_login_at DateTime?  @db.Timestamptz(6)
  created_at    DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?  @default(now()) @db.Timestamptz(6)

  assigned_tickets support_tickets[] @relation("ticket_assignee")
}

model custom_roles {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String     @db.Uuid
  name        String     @db.VarChar(100)
  slug        String     @db.VarChar(100)
  description String?
  permissions Json       @default("[]")
  is_active   Boolean    @default(true)
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @default(now()) @db.Timestamptz(6)
  businesses  businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)
  users       users[]

  @@unique([business_id, slug], map: "unq_business_role_slug")
  @@index([business_id], map: "idx_custom_roles_business")
  @@index([slug], map: "idx_custom_roles_slug")
