// ==========================================
// CUSTOMER SELF-SHOPPING PORTAL ORDERS
// ==========================================

enum customer_order_status {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  READY_FOR_BILLING
  BILLED
  CANCELLED
}

model customer_orders {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String                @db.Uuid
  order_number     String                @db.VarChar(50)
  status           customer_order_status @default(PENDING_REVIEW)
  session_token    String?               @db.VarChar(100)
  idempotency_key  String?               @unique @db.VarChar(100)
  customer_name    String?               @db.VarChar(150)
  customer_phone   String?               @db.VarChar(30)
  customer_address String?               @db.Text
  notes            String?               @db.Text
  rejection_reason String?               @db.Text
  adjustment_notes String?               @db.Text
  estimated_total  Decimal               @default(0.00) @db.Decimal(14, 2)
  customer_id      String?               @db.Uuid
  sale_id          String?               @db.Uuid
  reviewed_by      String?               @db.Uuid
  reviewed_at      DateTime?             @db.Timestamptz(6)
  created_at       DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?             @default(now()) @db.Timestamptz(6)

  businesses           businesses             @relation(fields: [business_id], references: [id], onDelete: Cascade)
  customers            customers?             @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  customer_order_items customer_order_items[]

  @@unique([business_id, order_number])
  @@index([business_id], map: "idx_cust_order_business")
  @@index([business_id, status, created_at], map: "idx_cust_order_biz_status_date")
  @@index([customer_id], map: "idx_cust_order_customer")
  @@index([status], map: "idx_cust_order_status")
  @@index([created_at], map: "idx_cust_order_created_at")
}

model customer_order_items {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id       String    @db.Uuid
  product_id     String    @db.Uuid
  variant_id     String?   @db.Uuid
  product_name   String    @db.VarChar(200)
  variant_name   String?   @db.VarChar(200)
  sku            String?   @db.VarChar(100)
  barcode        String?   @db.VarChar(100)
  color          String?   @db.VarChar(100)
  size           String?   @db.VarChar(50)
  quantity       Decimal   @db.Decimal(14, 3)
  unit_price     Decimal   @db.Decimal(14, 2)
  line_total     Decimal   @db.Decimal(14, 2)
  is_removed     Boolean   @default(false)
  removal_reason String?   @db.VarChar(255)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  customer_orders customer_orders @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id], map: "idx_cust_order_items_order")
  @@index([product_id], map: "idx_cust_order_items_product")
}

// ============================================================================
// HELP CENTER & SUPPORT TICKET MANAGEMENT SYSTEM MODELS
// ============================================================================

enum ticket_priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ticket_status {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum ticket_category {
  LOGIN_AUTHENTICATION
  DASHBOARD
  SALES_INVOICES
  PRODUCTS_INVENTORY
  PURCHASES_SUPPLIERS
  FINANCE_PAYMENTS
  QUOTATIONS
  CUSTOMER_PORTAL
  WHATSAPP_INTEGRATION
  SUBSCRIPTION_BILLING
  TECHNICAL_ERROR
  FEATURE_REQUEST
  OTHER
}

model support_tickets {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_number        String          @unique @db.VarChar(50)
  business_id          String          @db.Uuid
  user_id              String          @db.Uuid
  subject              String          @db.VarChar(255)
  category             ticket_category @default(OTHER)
  priority             ticket_priority @default(MEDIUM)
  status               ticket_status   @default(OPEN)
  affected_module      String?         @db.VarChar(100)
  description          String          @db.Text
  app_version          String?         @default("1.0.0") @db.VarChar(50)
  current_route        String?         @db.VarChar(255)
  assigned_to_admin_id String?         @db.Uuid
  resolved_at          DateTime?       @db.Timestamptz(6)
  closed_at            DateTime?       @db.Timestamptz(6)
  created_at           DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?       @default(now()) @db.Timestamptz(6)

  businesses     businesses                   @relation(fields: [business_id], references: [id], onDelete: Cascade)
  users          users                        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  assigned_admin admin_users?                 @relation("ticket_assignee", fields: [assigned_to_admin_id], references: [id], onUpdate: NoAction)
  attachments    support_ticket_attachments[]
  messages       support_ticket_messages[]
  activities     support_ticket_activities[]
  notifications  support_notifications[]

  @@index([business_id], map: "idx_support_tickets_business")
  @@index([user_id], map: "idx_support_tickets_user")
  @@index([status], map: "idx_support_tickets_status")
  @@index([priority], map: "idx_support_tickets_priority")
  @@index([category], map: "idx_support_tickets_category")
  @@index([created_at], map: "idx_support_tickets_created_at")
}

model support_ticket_attachments {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id  String    @db.Uuid
  message_id String?   @db.Uuid
  file_name  String    @db.VarChar(255)
  file_type  String    @db.VarChar(100)
  file_size  Int
  file_path  String    @db.VarChar(500)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  support_tickets support_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id], map: "idx_support_attach_ticket")
}

model support_ticket_messages {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id        String    @db.Uuid
  sender_type      String    @default("USER") @db.VarChar(30) // USER, ADMIN, SYSTEM
  user_id          String?   @db.Uuid
  admin_id         String?   @db.Uuid
  sender_name      String    @db.VarChar(150)
  message          String    @db.Text
  is_internal_note Boolean   @default(false)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  support_tickets support_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  users           users?          @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([ticket_id], map: "idx_support_msg_ticket")
  @@index([is_internal_note], map: "idx_support_msg_internal")
}

model support_ticket_activities {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id  String    @db.Uuid
  actor_type String    @db.VarChar(30) // USER, ADMIN, SYSTEM
  actor_name String    @db.VarChar(150)
  action     String    @db.VarChar(100) // STATUS_CHANGE, ASSIGNMENT, PRIORITY_CHANGE, NOTE_ADDED, REPLY_SENT
  old_value  String?   @db.Text
  new_value  String?   @db.Text
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  support_tickets support_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id], map: "idx_support_act_ticket")
}

model support_notifications {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id       String    @db.Uuid
  recipient_email String    @db.VarChar(150)
  recipient_type  String    @db.VarChar(50) // VEXA_TECH, COMPANY_ADMIN, SUBSCRIPTION_ADMIN, TICKET_OWNER
  subject         String    @db.VarChar(255)
  status          String    @default("PENDING") @db.VarChar(30) // PENDING, SENT, FAILED
  error_message   String?   @db.Text
  sent_at         DateTime? @db.Timestamptz(6)
  retry_count     Int       @default(0)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  support_tickets support_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id], map: "idx_support_notif_ticket")
  @@index([status], map: "idx_support_notif_status")
}

model help_categories {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique @db.VarChar(150)
  slug        String    @unique @db.VarChar(150)
  icon        String?   @default("BookOpen") @db.VarChar(50)
  description String?   @db.Text
  name_ta     String?   @db.VarChar(150)
  description_ta String? @db.Text
  sort_order  Int       @default(0)
  is_active   Boolean   @default(true)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  articles help_articles[]

  @@index([slug], map: "idx_help_cat_slug")
  @@index([sort_order], map: "idx_help_cat_sort")
}

model help_articles {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id         String    @db.Uuid
  title               String    @db.VarChar(255)
  slug                String    @unique @db.VarChar(255)
  short_description   String    @db.Text
  content_markdown    String    @db.Text
  cover_image         String?   @db.VarChar(500)
  steps               Json      @default("[]") // Array of { stepNumber, title, description, image, caption }
  important_notes     Json      @default("[]") // Array of string callouts
  related_article_ids Json      @default("[]") // Array of article IDs or slugs
  title_ta            String?   @db.VarChar(255)
  short_description_ta String?  @db.Text
  content_markdown_ta  String?  @db.Text
  steps_ta            Json?     @default("[]")
  important_notes_ta  Json?     @default("[]")
  search_keywords     String?   @db.Text
  is_published        Boolean   @default(true)
  is_featured         Boolean   @default(false)
  view_count          Int       @default(0)
  helpful_count       Int       @default(0)
  unhelpful_count     Int       @default(0)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)

  category help_categories       @relation(fields: [category_id], references: [id], onDelete: Cascade)
  images   help_article_images[]

  @@index([category_id], map: "idx_help_art_category")
  @@index([slug], map: "idx_help_art_slug")
  @@index([is_published], map: "idx_help_art_published")
  @@index([is_featured], map: "idx_help_art_featured")
}

model help_article_images {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  article_id String    @db.Uuid
  caption    String?   @db.VarChar(255)
  image_url  String    @db.VarChar(500)
  sort_order Int       @default(0)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  article help_articles @relation(fields: [article_id], references: [id], onDelete: Cascade)

  @@index([article_id], map: "idx_help_img_article")
}

model faqs {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category        String?   @default("General") @db.VarChar(100)
  question        String    @db.VarChar(255)
  answer          String    @db.Text
  question_ta     String?   @db.VarChar(255)
  answer_ta       String?   @db.Text
  slug            String?   @unique @db.VarChar(255)
  helpful_count   Int       @default(0)
  unhelpful_count Int       @default(0)
  sort_order      Int       @default(0)
  is_published    Boolean   @default(true)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@index([category], map: "idx_faqs_category")
  @@index([is_published], map: "idx_faqs_published")
  @@index([slug], map: "idx_faqs_slug")
}

model sales_enquiries {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiry_number      String    @unique @db.VarChar(50)
  contact_name        String    @db.VarChar(150)
  business_name       String    @db.VarChar(200)
  email               String    @db.VarChar(150)
  mobile              String    @db.VarChar(50)
  business_type       String?   @db.VarChar(100)
  interested_plan     String    @default("Lifetime – ₹59,999") @db.VarChar(100)
  current_plan        String?   @db.VarChar(100)
  preferred_time      String?   @db.VarChar(100)
  message             String    @db.Text
  source              String    @default("VEXA Invoice Lifetime Pricing") @db.VarChar(150)
  status              String    @default("NEW") @db.VarChar(50)
  business_id         String?   @db.Uuid
  company_id          String?   @db.VarChar(50)
  user_id             String?   @db.Uuid
  assigned_admin      String?   @db.VarChar(150)
  contact_date        DateTime? @db.Timestamptz(6)
  follow_up_date      DateTime? @db.Timestamptz(6)
  next_action         String?   @db.VarChar(255)
  email_notified      Boolean   @default(false)
  email_error         String?   @db.Text
  razorpay_order_id   String?   @db.VarChar(100)
  razorpay_payment_id String?   @db.VarChar(100)
  payment_status      String?   @db.VarChar(50)
  payment_amount      Decimal?  @db.Decimal(14, 2)
  converted_at        DateTime? @db.Timestamptz(6)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)

  businesses businesses?           @relation(fields: [business_id], references: [id], onDelete: SetNull)
  users      users?                @relation(fields: [user_id], references: [id], onDelete: SetNull)
  notes      sales_enquiry_notes[]

  @@index([enquiry_number], map: "idx_sales_enquiry_num")
  @@index([business_id], map: "idx_sales_enquiry_biz")
  @@index([company_id], map: "idx_sales_enquiry_comp")
  @@index([email], map: "idx_sales_enquiry_email")
  @@index([mobile], map: "idx_sales_enquiry_mobile")
  @@index([status], map: "idx_sales_enquiry_status")
  @@index([created_at], map: "idx_sales_enquiry_created")
}

model sales_enquiry_notes {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiry_id   String    @db.Uuid
  note_type    String    @default("INTERNAL_NOTE") @db.VarChar(50)
  note_text    String    @db.Text
  author_name  String    @default("Super Admin") @db.VarChar(150)
  author_email String?   @db.VarChar(150)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  enquiry sales_enquiries @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)

  @@index([enquiry_id], map: "idx_enquiry_notes_enquiry")
}






