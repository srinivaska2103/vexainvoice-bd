generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model customers {
  id                  String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id         String                         @db.Uuid
  customer_code       String?                        @db.VarChar(50)
  name                String                         @db.VarChar(200)
  customer_type       customer_type?                 @default(RETAIL)
  phone               String?                        @db.VarChar(20)
  email               String?                        @db.VarChar(150)
  address             String?
  city                String?                        @db.VarChar(100)
  state               String?                        @db.VarChar(100)
  pincode             String?                        @db.VarChar(10)
  gst_number          String?                        @db.VarChar(20)
  credit_limit        Decimal?                       @default(0) @db.Decimal(14, 2)
  opening_balance     Decimal?                       @default(0) @db.Decimal(14, 2)
  current_balance     Decimal?                       @default(0) @db.Decimal(14, 2)
  price_level         String?                        @default("RETAIL") @db.VarChar(30)
  is_active           Boolean?                       @default(true)
  created_at          DateTime?                      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?                      @default(now()) @db.Timestamptz(6)
  customer_payments   customer_payments[]
  businesses          businesses                     @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotations          quotations[]
  sales               sales[]
  whatsapp_recipients whatsapp_campaign_recipients[]
  whatsapp_messages   whatsapp_messages[]
  crm_follow_ups      crm_follow_ups[]
  crm_customer_notes  crm_customer_notes[]
  customer_orders     customer_orders[]

  @@unique([business_id, customer_code])
  @@index([business_id], map: "idx_customers_business")
  @@index([phone], map: "idx_customers_phone")
}

model products {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id        String               @db.Uuid
  category_id        String?              @db.Uuid
  brand_id           String?              @db.Uuid
  name               String               @db.VarChar(200)
  sku                String?              @db.VarChar(100)
  barcode            String?              @db.VarChar(100)
  description        String?
  unit               unit_type            @default(PCS)
  hsn_code           String?              @db.VarChar(20)
  gst_percentage     Decimal?             @default(0) @db.Decimal(5, 2)
  purchase_price     Decimal?             @default(0) @db.Decimal(14, 2)
  retail_price       Decimal?             @default(0) @db.Decimal(14, 2)
  wholesale_price    Decimal?             @default(0) @db.Decimal(14, 2)
  dealer_price       Decimal?             @default(0) @db.Decimal(14, 2)
  minimum_stock      Decimal?             @default(0) @db.Decimal(14, 3)
  maximum_stock      Decimal?             @db.Decimal(14, 3)
  has_variants       Boolean?             @default(false)
  is_active          Boolean?             @default(true)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  product_stock      product_stock[]
  product_variants   product_variants[]
  brands             brands?              @relation(fields: [brand_id], references: [id], onUpdate: NoAction)
  businesses         businesses           @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categories         categories?          @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  purchase_items     purchase_items[]
  quotation_items    quotation_items[]
  sale_items         sale_items[]
  stock_transactions stock_transactions[]

  @@unique([business_id, barcode])
  @@unique([business_id, sku])
  @@index([barcode], map: "idx_products_barcode")
  @@index([business_id], map: "idx_products_business")
  @@index([business_id, is_active], map: "idx_products_business_active")
  @@index([sku], map: "idx_products_sku")
}

model stock_transactions {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String                 @db.Uuid
  product_id       String                 @db.Uuid
  variant_id       String?                @db.Uuid
  transaction_type stock_transaction_type
  quantity         Decimal                @db.Decimal(14, 3)
  reference_id     String?                @db.Uuid
  reference_number String?                @db.VarChar(100)
  notes            String?
  transaction_date DateTime?              @default(now()) @db.Timestamptz(6)
  created_by       String?                @db.Uuid
  businesses       businesses             @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?                 @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  products         products               @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  product_variants product_variants?      @relation(fields: [variant_id], references: [id], onUpdate: NoAction)

  @@index([business_id], map: "idx_stock_business")
  @@index([business_id, product_id, variant_id], map: "idx_stock_biz_prod_var")
  @@index([business_id, transaction_type], map: "idx_stock_biz_tx_type")
  @@index([transaction_date], map: "idx_stock_date")
  @@index([product_id], map: "idx_stock_product")
}

model users {
  id                      String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id             String                         @db.Uuid
  name                    String                         @db.VarChar(150)
  email                   String?                        @db.VarChar(150)
  phone                   String?                        @db.VarChar(20)
  password_hash           String
  role                    user_role                      @default(BILLING_STAFF)
  custom_role_id          String?                        @db.Uuid
  custom_roles            custom_roles?                  @relation(fields: [custom_role_id], references: [id], onDelete: SetNull)
  is_active               Boolean?                       @default(true)
  created_at              DateTime?                      @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                      @default(now()) @db.Timestamptz(6)
  audit_logs              audit_logs[]
  customer_payments       customer_payments[]
  purchase_payments       purchase_payments[]
  purchases               purchases[]
  quotations              quotations[]
  sale_payments           sale_payments[]
  sales                   sales[]
  stock_transactions      stock_transactions[]
  supplier_payments       supplier_payments[]
  whatsapp_txs            whatsapp_wallet_transactions[]
  whatsapp_campaigns      whatsapp_campaigns[]
  crm_followups_assigned  crm_follow_ups[]               @relation("crm_followups_assigned")
  crm_followups_created   crm_follow_ups[]               @relation("crm_followups_creator")
  crm_customer_notes      crm_customer_notes[]
  crm_saved_segments      crm_saved_segments[]
  support_tickets         support_tickets[]
  support_ticket_messages support_ticket_messages[]
  businesses              businesses                     @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sales_enquiries         sales_enquiries[]

  @@unique([business_id, email])
  @@index([business_id], map: "idx_users_business")
}

model audit_logs {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id  String     @db.Uuid
  user_id      String?    @db.Uuid
  action       String     @db.VarChar(100)
  module       String     @db.VarChar(100)
  reference_id String?    @db.Uuid
  old_data     Json?
  new_data     Json?
  created_at   DateTime?  @default(now()) @db.Timestamptz(6)
  businesses   businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users?     @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([business_id], map: "idx_audit_logs_business")
  @@index([created_at], map: "idx_audit_logs_created_at")
  @@index([user_id], map: "idx_audit_logs_user")
}

model brands {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String     @db.Uuid
  name        String     @db.VarChar(150)
  is_active   Boolean?   @default(true)
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  businesses  businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products[]

  @@unique([business_id, name])
}

model businesses {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_name       String               @db.VarChar(200)
  business_type       business_type
  owner_name          String?              @db.VarChar(150)
  phone               String?              @db.VarChar(20)
  email               String?              @db.VarChar(150)
  address             String?
  city                String?              @db.VarChar(100)
  state               String?              @db.VarChar(100)
  pincode             String?              @db.VarChar(10)
  gst_number          String?              @db.VarChar(20)
  pan_number          String?              @db.VarChar(20)
  logo_url            String?
  currency            String?              @default("INR") @db.VarChar(10)
  invoice_prefix      String?              @default("INV") @db.VarChar(20)
  next_invoice_number BigInt?              @default(1)
  company_id          String?              @unique @db.VarChar(50)
  subscription_status subscription_status? @default(ACTIVE)
  license_status      license_status?      @default(ACTIVE)
  trial_start_at      DateTime?            @db.Timestamptz(6)
  trial_end_at        DateTime?            @db.Timestamptz(6)
  has_used_trial      Boolean?             @default(false)

  // QR Self-Shopping & Customer Orders Entitlement Tracking
  self_shopping_status         self_shopping_status? @default(TRIALING)
  self_shopping_trial_start_at DateTime?             @db.Timestamptz(6)
  self_shopping_trial_end_at   DateTime?             @db.Timestamptz(6)
  has_used_self_shopping_trial Boolean?              @default(false)

  is_active                    Boolean?                       @default(true)
  created_at                   DateTime?                      @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime?                      @default(now()) @db.Timestamptz(6)
  audit_logs                   audit_logs[]
  brands                       brands[]
  categories                   categories[]
  colors                       colors[]
  customer_payments            customer_payments[]
  customers                    customers[]
  product_stock                product_stock[]
  products                     products[]
  purchases                    purchases[]
  quotations                   quotations[]
  sales                        sales[]
  sizes                        sizes[]
  stock_transactions           stock_transactions[]
  supplier_payments            supplier_payments[]
  suppliers                    suppliers[]
  users                        users[]
  email_logs                   email_logs[]
  whatsapp_wallets             whatsapp_wallets?
  whatsapp_wallet_transactions whatsapp_wallet_transactions[]
  whatsapp_campaigns           whatsapp_campaigns[]
  whatsapp_messages            whatsapp_messages[]
  whatsapp_accounts            whatsapp_accounts?
  crm_follow_ups               crm_follow_ups[]
  crm_customer_notes           crm_customer_notes[]
  crm_saved_segments           crm_saved_segments[]
  platform_subscriptions       platform_subscriptions[]
  platform_licenses            platform_licenses[]
  payment_transactions         payment_transactions[]
  payment_receipts             payment_receipts[]
  custom_roles                 custom_roles[]
  customer_orders              customer_orders[]
  support_tickets              support_tickets[]
  sales_enquiries              sales_enquiries[]
}

model categories {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String     @db.Uuid
  name        String     @db.VarChar(150)
  description String?
  is_active   Boolean?   @default(true)
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  businesses  businesses @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products[]

  @@unique([business_id, name])
}

model colors {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String             @db.Uuid
  name             String             @db.VarChar(100)
  hex_code         String?            @db.VarChar(10)
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  businesses       businesses         @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants[]

  @@unique([business_id, name])
}

model customer_payments {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String         @db.Uuid
  customer_id      String         @db.Uuid
  sale_id          String?        @db.Uuid
  amount           Decimal        @db.Decimal(14, 2)
  payment_method   payment_method
  payment_date     DateTime?      @default(now()) @db.Timestamptz(6)
  reference_number String?        @db.VarChar(100)
  notes            String?
  created_by       String?        @db.Uuid
  businesses       businesses     @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?         @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  customers        customers      @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sales            sales?         @relation(fields: [sale_id], references: [id], onUpdate: NoAction)

  @@index([customer_id], map: "idx_customer_payments_customer")
  @@index([business_id], map: "idx_customer_payments_business")
  @@index([business_id, payment_date], map: "idx_customer_payments_biz_date")
}

model product_stock {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String            @db.Uuid
  product_id       String            @db.Uuid
  variant_id       String?           @db.Uuid
  quantity         Decimal?          @default(0) @db.Decimal(14, 3)
  updated_at       DateTime?         @default(now()) @db.Timestamptz(6)
  businesses       businesses        @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products         products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([business_id, product_id, variant_id])
}

model product_variants {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id         String               @db.Uuid
  color_id           String?              @db.Uuid
  size_id            String?              @db.Uuid
  variant_name       String?              @db.VarChar(200)
  sku                String?              @db.VarChar(100)
  barcode            String?              @db.VarChar(100)
  purchase_price     Decimal?             @default(0) @db.Decimal(14, 2)
  retail_price       Decimal?             @default(0) @db.Decimal(14, 2)
  wholesale_price    Decimal?             @default(0) @db.Decimal(14, 2)
  dealer_price       Decimal?             @default(0) @db.Decimal(14, 2)
  opening_stock      Decimal?             @default(0) @db.Decimal(14, 3)
  current_stock      Decimal?             @default(0) @db.Decimal(14, 3)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  product_stock      product_stock[]
  colors             colors?              @relation(fields: [color_id], references: [id], onUpdate: NoAction)
  products           products             @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sizes              sizes?               @relation(fields: [size_id], references: [id], onUpdate: NoAction)
  purchase_items     purchase_items[]
  quotation_items    quotation_items[]
  sale_items         sale_items[]
  stock_transactions stock_transactions[]

  @@unique([product_id, barcode])
  @@unique([product_id, sku])
  @@index([barcode], map: "idx_product_variants_barcode")
  @@index([product_id], map: "idx_product_variants_product")
}

model purchase_items {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchase_id      String            @db.Uuid
  product_id       String            @db.Uuid
  variant_id       String?           @db.Uuid
  product_name     String            @db.VarChar(200)
  quantity         Decimal           @db.Decimal(14, 3)
  unit_price       Decimal           @db.Decimal(14, 2)
  discount_amount  Decimal?          @default(0) @db.Decimal(14, 2)
  gst_percentage   Decimal?          @default(0) @db.Decimal(5, 2)
  taxable_amount   Decimal?          @default(0) @db.Decimal(14, 2)
  cgst_amount      Decimal?          @default(0) @db.Decimal(14, 2)
  sgst_amount      Decimal?          @default(0) @db.Decimal(14, 2)
  igst_amount      Decimal?          @default(0) @db.Decimal(14, 2)
  total_amount     Decimal?          @default(0) @db.Decimal(14, 2)
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  products         products          @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  purchases        purchases         @relation(fields: [purchase_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction)
}

model purchase_payments {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchase_id      String         @db.Uuid
  payment_method   payment_method
  amount           Decimal        @db.Decimal(14, 2)
  payment_date     DateTime?      @default(now()) @db.Timestamptz(6)
  reference_number String?        @db.VarChar(100)
  notes            String?
  created_by       String?        @db.Uuid
  users            users?         @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  purchases        purchases      @relation(fields: [purchase_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model purchases {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id       String              @db.Uuid
  supplier_id       String?             @db.Uuid
  purchase_number   String              @db.VarChar(50)
  purchase_date     DateTime?           @default(now()) @db.Timestamptz(6)
  subtotal          Decimal?            @default(0) @db.Decimal(14, 2)
  discount_amount   Decimal?            @default(0) @db.Decimal(14, 2)
  taxable_amount    Decimal?            @default(0) @db.Decimal(14, 2)
  cgst_amount       Decimal?            @default(0) @db.Decimal(14, 2)
  sgst_amount       Decimal?            @default(0) @db.Decimal(14, 2)
  igst_amount       Decimal?            @default(0) @db.Decimal(14, 2)
  round_off         Decimal?            @default(0) @db.Decimal(14, 2)
  grand_total       Decimal?            @default(0) @db.Decimal(14, 2)
  paid_amount       Decimal?            @default(0) @db.Decimal(14, 2)
  balance_amount    Decimal?            @default(0) @db.Decimal(14, 2)
  notes             String?
  created_by        String?             @db.Uuid
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?           @default(now()) @db.Timestamptz(6)
  purchase_items    purchase_items[]
  purchase_payments purchase_payments[]
  businesses        businesses          @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users?              @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  suppliers         suppliers?          @relation(fields: [supplier_id], references: [id], onUpdate: NoAction)
  supplier_payments supplier_payments[]

  @@unique([business_id, purchase_number])
  @@index([business_id], map: "idx_purchases_business")
  @@index([purchase_date], map: "idx_purchases_date")
  @@index([supplier_id], map: "idx_purchases_supplier")
}

model quotation_items {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotation_id     String            @db.Uuid
  product_id       String?           @db.Uuid
  variant_id       String?           @db.Uuid
  product_name     String            @db.VarChar(200)
  quantity         Decimal           @db.Decimal(14, 3)
  unit_price       Decimal           @db.Decimal(14, 2)
  discount_amount  Decimal?          @default(0) @db.Decimal(14, 2)
  gst_percentage   Decimal?          @default(0) @db.Decimal(5, 2)
  total_amount     Decimal?          @default(0) @db.Decimal(14, 2)
  products         products?         @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  quotations       quotations        @relation(fields: [quotation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction)
}

model quotations {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String            @db.Uuid
  customer_id      String?           @db.Uuid
  quotation_number String            @db.VarChar(50)
  quotation_date   DateTime?         @default(now()) @db.Timestamptz(6)
  valid_until      DateTime?         @db.Date
  subtotal         Decimal?          @default(0) @db.Decimal(14, 2)
  discount_amount  Decimal?          @default(0) @db.Decimal(14, 2)
  tax_amount       Decimal?          @default(0) @db.Decimal(14, 2)
  grand_total      Decimal?          @default(0) @db.Decimal(14, 2)
  notes            String?
  created_by       String?           @db.Uuid
  created_at       DateTime?         @default(now()) @db.Timestamptz(6)
  quotation_items  quotation_items[]
  businesses       businesses        @relation(fields: [business_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?            @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  customers        customers?        @relation(fields: [customer_id], references: [id], onUpdate: NoAction)

  @@unique([business_id, quotation_number])
}

model sale_items {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sale_id             String            @db.Uuid
  product_id          String            @db.Uuid
  variant_id          String?           @db.Uuid
  product_name        String            @db.VarChar(200)
  sku                 String?           @db.VarChar(100)
  quantity            Decimal           @db.Decimal(14, 3)
  unit_price          Decimal           @db.Decimal(14, 2)
  discount_percentage Decimal?          @default(0) @db.Decimal(5, 2)
  discount_amount     Decimal?          @default(0) @db.Decimal(14, 2)
  gst_percentage      Decimal?          @default(0) @db.Decimal(5, 2)
  taxable_amount      Decimal?          @default(0) @db.Decimal(14, 2)
  cgst_amount         Decimal?          @default(0) @db.Decimal(14, 2)
  sgst_amount         Decimal?          @default(0) @db.Decimal(14, 2)
  igst_amount         Decimal?          @default(0) @db.Decimal(14, 2)
  total_amount        Decimal?          @default(0) @db.Decimal(14, 2)
  created_at          DateTime?         @default(now()) @db.Timestamptz(6)
  products            products          @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  sales               sales             @relation(fields: [sale_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants    product_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction)

  @@index([product_id], map: "idx_sale_items_product")
  @@index([sale_id], map: "idx_sale_items_sale")
}

model sale_payments {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sale_id          String         @db.Uuid
  payment_method   payment_method
  amount           Decimal        @db.Decimal(14, 2)
  payment_date     DateTime?      @default(now()) @db.Timestamptz(6)
  reference_number String?        @db.VarChar(100)
  notes            String?
  created_by       String?        @db.Uuid
  users            users?         @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  sales            sales          @relation(fields: [sale_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model sales {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id       String              @db.Uuid
  customer_id       String?             @db.Uuid
  invoice_number    String              @db.VarChar(50)
  invoice_type      invoice_type        @default(SALE)
  status            invoice_status      @default(DRAFT)
  invoice_date      DateTime?           @default(now()) @db.Timestamptz(6)
  subtotal          Decimal?            @default(0) @db.Decimal(14, 2)
